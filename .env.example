# ─────────────────────────────────────────────────────────────
# MANTRA SPORTS INDIA — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# The same variables are set in Vercel for production.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mantra Sports India"
NEXT_PUBLIC_REGION=in

# ── Database ─────────────────────────────────────────────────
# Local development (PostgreSQL) — India database only
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/mantra_sports_in

# Portable Postgres folder used by `npm run db:local:start` (dev only)
LOCAL_PG_HOME=C:/Users/YOU/AppData/Local/MantraSportsIN

# Production — the India Neon project (never the NL database)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/mantra_sports_in?sslmode=require

# ── Authentication ────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# First admin user, created by `npm run db:seed`
DEV_ADMIN_EMAIL=admin@mantrasports.co.in
DEV_ADMIN_PASSWORD=

# ── Email / SMTP (order confirmation & shipping emails) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mantra Sports India <noreply@mantrasports.co.in>"


# ── WhatsApp ─────────────────────────────────────────────────
# International format without +, e.g. 91XXXXXXXXXX. Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Cloudinary (product & media images) ─────────────────────
# Settings > API Keys. Uploads are signed by the server and go to the
# mantrasports-in/ folders; no upload preset is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MantraOS Integration ─────────────────────────────────────
# Mirrors every enquiry into MantraOS as a lead Opportunity. Get this
# from MantraOS: Settings > Lead Intake > Create key, for the INDIA
# company. Treat like a password.
MANTRA_LEAD_INTAKE_KEY=

# ── Razorpay (online payments) ───────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys. Use test keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks: URL https://www.mantrasports.co.in/api/razorpay/webhook
# events payment.captured, order.paid, payment.failed — paste the webhook secret here
RAZORPAY_WEBHOOK_SECRET=

# ── Order emails ─────────────────────────────────────────────
# Inbox that receives "new order" notifications (defaults to the contact email setting)
ORDER_NOTIFY_EMAIL=

# ── Google reviews (Places API) ──────────────────────────────
# Google Cloud → enable "Places API (New)" → create an API key (restrict to Places API)
GOOGLE_PLACES_API_KEY=
